{
  "name": "eslint-plugin-oxfmt-vue",
  "version": "0.1.1",
  "description": "Format files with oxfmt in ESLint, and Vue SFCs block by block",
  "keywords": [
    "eslint",
    "eslint-plugin",
    "eslintplugin",
    "formatter",
    "oxc",
    "oxfmt",
    "vue"
  ],
  "homepage": "https://github.com/Mini-ghost/eslint-plugin-oxfmt-vue#readme",
  "bugs": {
    "url": "https://github.com/Mini-ghost/eslint-plugin-oxfmt-vue/issues"
  },
  "license": "MIT",
  "author": "Alex Liu",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Mini-ghost/eslint-plugin-oxfmt-vue.git"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "default": "./dist/index.mjs"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsdown",
    "format": "oxfmt src test/*.ts *.ts *.json *.md",
    "prepack": "pnpm build",
    "test": "pnpm build && vitest run",
    "type-check": "tsrs --noEmit"
  },
  "dependencies": {
    "@vue/compiler-sfc": "^3.0.0",
    "load-oxfmt-config": "^0.33.0",
    "picomatch": "^4.0.7",
    "prettier-linter-helpers": "^1.0.1",
    "synckit": "^0.12.3"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/picomatch": "^4.0.3",
    "eslint": "^10.12.0",
    "eslint-parser-plain": "^0.1.1",
    "eslint-v9": "npm:eslint@^9.39.0",
    "oxfmt": "0.79.0",
    "tsdown": "^0.23.7",
    "tsrs": "7.1.0-beta.tsrs4",
    "vitest": "^5.1.1"
  },
  "peerDependencies": {
    "eslint": "^9.5.0 || ^10.0.0",
    "oxfmt": ">=0.79.0"
  },
  "engines": {
    "node": "^22.13.0 || >=24"
  },
  "packageManager": "pnpm@12.14.0"
}
